# Supabase (anon key only. NEVER put the service_role key here).
# Leave both empty to run in demo/offline mode (IndexedDB).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public base path = "/<repo-name>/" on GitHub Pages
VITE_BASE=/cutreview/

# Client-side upload limit in MB (Supabase free tier default is 50)
VITE_MAX_UPLOAD_MB=50